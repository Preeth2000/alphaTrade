# Copy to .env and fill in values. Never commit .env.
T212_ACTIVE_ACCOUNT=demo        # demo | invest | isa

T212_DEMO_API_KEY=your_demo_api_key
T212_DEMO_SECRET_KEY=your_demo_secret_key

T212_INVEST_API_KEY=
T212_INVEST_SECRET_KEY=

T212_ISA_API_KEY=
T212_ISA_SECRET_KEY=

DATA_PROVIDER=yfinance  # yfinance | polygon
POLYGON_API_KEY=        # required only when DATA_PROVIDER=polygon

# Paths (relative to working directory or absolute)
MODELS_DIR=./models
# Shared platform postgres password (must match alphaFrame platform stack)
POSTGRES_PASSWORD=changeme
# Set DATABASE_URL for Postgres. Leave blank to use SQLite fallback (STATE_DB_PATH).
# Example: postgresql+psycopg2://user:pass@localhost/alphatrade
DATABASE_URL=
STATE_DB_PATH=./state.db        # used only when DATABASE_URL is blank
OVERRIDES_PATH=./overrides.yaml
LOG_FILE=./alphaTrade.log

# API
API_PORT=8081

# Webhook alerts (generic)
WEBHOOK_URL=
WEBHOOK_LEVEL=WARNING

# Slack alerts
ALERTS__SLACK__ENABLED=false
ALERTS__SLACK__WEBHOOK_URL=
ALERTS__SLACK__MIN_LEVEL=WARNING

# Email alerts
ALERTS__EMAIL__ENABLED=false
ALERTS__EMAIL__SMTP_HOST=smtp.gmail.com
ALERTS__EMAIL__SMTP_PORT=587
ALERTS__EMAIL__SMTP_USER=
ALERTS__EMAIL__SMTP_PASSWORD=
ALERTS__EMAIL__FROM_ADDR=
ALERTS__EMAIL__TO_ADDRS=["owner@example.com"]
ALERTS__EMAIL__MIN_LEVEL=WARNING

# Redis
REDIS__URL=redis://localhost:6379/0
REDIS__ENABLED=true

# MinIO / model storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=models
MODEL_USER=default
MODEL_ACCOUNT=default
MODEL_SYNC_POLL_INTERVAL=60
MODEL_MAX_VERSIONS=5          # -1 = unbounded
MODEL_VALIDATION_MIN_SHARPE=0.5
MODEL_VALIDATION_MAX_DRAWDOWN=0.20
MODEL_VALIDATION_MIN_HIT_RATE=0.45
