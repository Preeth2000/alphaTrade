{
  "consumer": {
    "name": "alphaLink"
  },
  "interactions": [
    {
      "description": "a demote request for a model with no production alias",
      "providerStates": [
        {
          "name": "no production alias exists for the model",
          "params": {
            "modelName": "missing-production-model"
          }
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Authorization": "Bearer test-token-placeholder",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/models/missing-production-model/demote"
      },
      "response": {
        "body": {
          "detail": "No production alias for 'missing-production-model'"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.detail": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a demote request for a production model",
      "providerStates": [
        {
          "name": "a model exists in production",
          "params": {
            "modelName": "pact-test-model-2",
            "version": "5"
          }
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Authorization": "Bearer test-token-placeholder",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/models/pact-test-model-2/demote"
      },
      "response": {
        "body": {
          "model_name": "pact-test-model-2",
          "stage": "staging",
          "version": "5"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a halt request",
      "providerStates": [
        {
          "name": "the kill switch is not active"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-token-placeholder"
        },
        "method": "POST",
        "path": "/halt"
      },
      "response": {
        "body": {
          "halted": true,
          "sentinel_file": "HALT"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.sentinel_file": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a kill-switch status request",
      "providerStates": [
        {
          "name": "the kill switch is not active"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-token-placeholder"
        },
        "method": "GET",
        "path": "/kill-switch"
      },
      "response": {
        "body": {
          "halted": false,
          "sentinel_file": "HALT"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.sentinel_file": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a promote request for a model with no staging alias",
      "providerStates": [
        {
          "name": "no staging alias exists for the model",
          "params": {
            "modelName": "missing-staging-model"
          }
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Authorization": "Bearer test-token-placeholder",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/models/missing-staging-model/promote"
      },
      "response": {
        "body": {
          "detail": "No staging alias for 'missing-staging-model'"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.detail": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a promote request for a staged model",
      "providerStates": [
        {
          "name": "a model exists in staging",
          "params": {
            "modelName": "pact-test-model",
            "version": "3"
          }
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Authorization": "Bearer test-token-placeholder",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/models/pact-test-model/promote"
      },
      "response": {
        "body": {
          "model_name": "pact-test-model",
          "stage": "production",
          "version": "3"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a resume request",
      "providerStates": [
        {
          "name": "the kill switch is active"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-token-placeholder"
        },
        "method": "POST",
        "path": "/resume"
      },
      "response": {
        "body": {
          "halted": false,
          "sentinel_file": "HALT"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.sentinel_file": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "alphaTrade"
  }
}